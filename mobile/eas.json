{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_ALLOW_CLEARTEXT": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://mait-ai.shwetdharamilk.com:8001/api/v1",
        "EXPO_ALLOW_CLEARTEXT": "true",
        "EXPO_PUBLIC_SERVER_CONFIG_URL": "https://raw.githubusercontent.com/Shivamchaubey14/mait-ai/develop/mobile/server.json"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://mait-ai.shwetdharamilk.com:8001/api/v1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
