# The Expo SDK 54 packages and React 19 disagree on some peer ranges. npm's strict resolver
# refuses the tree outright; legacy resolution installs it and it works.
#
# This lives in a file rather than a command-line flag because `npm ci` in CI does not
# inherit flags — without it the lock file and CI resolve differently and the build fails
# with a sync error that says nothing about peer dependencies.
legacy-peer-deps=true
