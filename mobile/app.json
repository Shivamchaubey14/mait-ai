{
  "expo": {
    "name": "Mait AI",
    "slug": "mait-ai",
    "scheme": "maitai",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "primaryColor": "#3BB77E",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#253D4E"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.Shwetdhara.maitai"
    },
    "android": {
      "package": "in.Shwetdhara.maitai",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3BB77E"
      },
      "permissions": ["CAMERA", "ACCESS_FINE_LOCATION"],
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Mait AI uses the camera to photograph the animal as proof of the insemination, and to photograph a non-member's Aadhaar card when she is registered.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Mait AI can take the proof photo from your gallery when the camera cannot be used. The record says which photos were chosen rather than taken."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Mait AI stamps the AI photo with where it was taken, so the event can be tied to the right village."
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://127.0.0.1:8000/api/v1",
      "itSupportPhone": "",
      "eas": {
        "projectId": "77b3f3ab-5b47-4489-a134-2b1d732277a6"
      }
    },
    "owner": "shivam1214"
  }
}
