{
  "name": "mait-app",
  "version": "0.1.0",
  "private": true,
  "description": "Mait AI field agent app — React Native, Android-first",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json}\""
  },
  "dependencies": {
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@reduxjs/toolkit": "^2.2.7",
    "@sentry/react-native": "^5.33.1",
    "i18next": "^23.15.1",
    "react": "19.2.8",
    "react-i18next": "^15.0.2",
    "react-native": "0.86.2",
    "react-native-geolocation-service": "^5.3.1",
    "react-native-mmkv": "^4.3.2",
    "react-native-quick-sqlite": "^8.1.0",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.26.2",
    "react-native-vision-camera": "^5.2.1",
    "react-redux": "^9.1.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@react-native/typescript-config": "0.86.2",
    "@testing-library/react-native": "^12.7.2",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.18",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20"
  }
}
