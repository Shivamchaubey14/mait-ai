    "@react-native/jest-preset": "^0.86.3",
    "@react-native/typescript-config": "0.75.4",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.13",
    "@types/react": "~19.2.4",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "prettier": "^3.3.3",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "index.js",
