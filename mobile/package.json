{
  "name": "mait-app",
  "version": "0.1.0",
  "private": true,
  "description": "Mait AI field agent app — React Native, Android-first",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start -c",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "tunnel": "expo start --tunnel",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json}\""
  },
  "dependencies": {
    "@expo-google-fonts/nunito-sans": "^0.4.2",
    "@expo-google-fonts/quicksand": "^0.4.1",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@reduxjs/toolkit": "^2.2.7",
    "expo": "~54.0.0",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-location": "~19.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "i18next": "^23.15.1",
    "intl-pluralrules": "^2.0.1",
    "react": "19.2.8",
    "react-i18next": "^15.0.2",
    "react-native": "0.87.1",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.27.0",
    "react-native-webview": "14.0.1",
    "react-redux": "^9.1.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.13",
    "@types/react": "~19.2.18",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "prettier": "^3.3.3",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "index.js",
  "overrides": {
    "postcss": "^8.5.25"
  }
}
