{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true,
    "jquery": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "globals": {
    "Chart": "readonly",
    "MaitAI": "writable",
    "jQuery": "readonly",
    "$": "readonly"
  },
  "rules": {
    "no-console": [
      "warn",
      {
        "allow": [
          "warn",
          "error"
        ]
      }
    ],
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_"
      }
    ],
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error"
  }
}
