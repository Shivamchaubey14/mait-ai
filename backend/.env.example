# =======================================================================================
# Mait AI backend — environment template
#
# Copy to `.env` and fill in. NEVER commit the filled file (.gitignore blocks it).
# Every deployed environment gets its own values — see docs/DEPLOYMENT.md.
# =======================================================================================

# --- Core ------------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-generate-a-fresh-50-char-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- PII encryption --------------------------------------------------------------------
# Fernet key protecting Aadhaar / PAN / bank columns at rest.
# Generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# LOSING THIS KEY MAKES EVERY ENCRYPTED PII COLUMN PERMANENTLY UNREADABLE.
# Back it up in the secret manager before you use it for anything real.
FIELD_ENCRYPTION_KEY=

# --- Database --------------------------------------------------------------------------
DATABASE_URL=mysql://maitai:maitai@127.0.0.1:3306/maitai
# Read replica used for dashboard/report queries. Leave blank to read from the primary.
DATABASE_REPLICA_URL=
DB_CONN_MAX_AGE=60

# --- Redis (cache, OTP store, Celery broker) --------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0

# --- JWT -------------------------------------------------------------------------------
# Separate signing keys per environment, so a staging token is worthless in production.
JWT_SIGNING_KEY=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- Object storage (AI photos, payment screenshots) ------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1

# --- SMS / OTP gateway ------------------------------------------------------------------
# Vendor still to be confirmed — SRS §18.2 item 3. `console` prints OTPs to stdout.
SMS_GATEWAY_PROVIDER=console
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER_ID=MAITAI
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3

# --- Indent Easy integration ------------------------------------------------------------
INDENT_EASY_BASE_URL=
INDENT_EASY_API_KEY=
INDENT_EASY_WEBHOOK_SECRET=
INDENT_EASY_TIMEOUT=15

# --- Domain tuning ----------------------------------------------------------------------
IDEMPOTENCY_TTL_HOURS=24
LOW_STOCK_THRESHOLD=5

# --- Observability ----------------------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
APP_VERSION=dev

# --- CORS / CSRF (production only) -------------------------------------------------------
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
